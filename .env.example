# Copy to .env and adjust. Never commit .env.
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# development, testing or production (used when create_app gets no name)
FLASK_CONFIG=development
# Lets plain "flask run" find the app factory and use port 8002
FLASK_APP=app
FLASK_RUN_PORT=8002

# Public address that short links are built from
BASE_URL=http://localhost:8002

# How many reverse proxies sit in front of the app. 0 locally; 1 on Render.
# Too high lets clients fake their IP (and dodge rate limits) via X-Forwarded-For.
NUM_PROXIES=0

# Postgres from docker-compose.yml (host port 5435)
POSTGRES_DB=url_shortener
POSTGRES_USER=shortener
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://shortener:change-me@localhost:5435/url_shortener
# Same server, separate database. The tests create it if it's missing and
# create/drop tables in it, so it must never be the database above.
TEST_DATABASE_URL=postgresql+psycopg://shortener:change-me@localhost:5435/url_shortener_test

# Days a new link lives before it answers 410 Gone. Empty: links never expire.
# The public demo uses 7.
LINK_TTL_DAYS=
